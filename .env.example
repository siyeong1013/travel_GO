# Copy to .env.local and fill in. Never commit .env.local.
# Google Cloud: enable "Maps JavaScript API" and "Places API (New)", restrict key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: Map ID for the map's markers (Advanced Markers). Empty: Google's DEMO_MAP_ID,
# fine for development; create a Map ID in the Cloud console before release.
VITE_GOOGLE_MAPS_MAP_ID=
